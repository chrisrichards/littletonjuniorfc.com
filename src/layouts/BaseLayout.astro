---
import { Image } from 'astro:assets';
import logo from '../assets/brand/ljfc-logo.png';
import '../styles/app.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'teams' | 'official-info' | 'membership' | 'resources' | 'contact-us';
}

const {
  title,
  description = 'Littleton Junior Football Club - boys and girls football from 5 to 18',
  active,
} = Astro.props;

const navLeft = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/teams', label: 'Teams', key: 'teams' },
  { href: '/official-info', label: 'Official<br/>Info', key: 'official-info' },
];

const navRight = [
  { href: '/membership', label: 'Membership', key: 'membership' },
  { href: '/resources', label: 'Resources', key: 'resources' },
  { href: '/contact-us', label: 'Contact<br/>Us', key: 'contact-us' },
];
---

<!DOCTYPE html>
<html lang="en-gb" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favico-96.png" />
    <link rel="apple-touch-icon" href="/ljfc-ico-180.png" />
    <meta name="description" content={description} />
    <title>{title}</title>

    {/* Preload the two self-hosted fonts so display text (BebasKai) and body
        copy (TradeGothic) paint without a flash. Paired with font-display:swap
        in custom.css. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/templates/yootheme/fonts/3A11AF_0_0.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/templates/yootheme/fonts/TradeGothicLT.woff2"
      crossorigin
    />

    {/* Gate the home-squares scrollspy fade-in. Set synchronously in <head>
        (before first paint, so cards never flash visible-then-hidden) and
        only when JS + IntersectionObserver are available and the user hasn't
        asked for reduced motion — otherwise the cards stay visible. The CSS
        `opacity: 0` is scoped to `.scrollspy-enabled` (see app.css). */}
    <script is:inline>
      (function () {
        if (
          'IntersectionObserver' in window &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('scrollspy-enabled');
        }
      })();
    </script>
  </head>
  <body class="">
    <div class="tm-page-container">
      <div class="tm-page">
        {/* Mobile header */}
        <div class="tm-header-mobile mobile-header">
          <nav class="mobile-nav">
            <button
              class="nav-toggle"
              type="button"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls="mobile-drawer"
              data-drawer-open
            >
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="currentColor">
                <rect y="3" width="20" height="2"></rect>
                <rect y="9" width="20" height="2"></rect>
                <rect y="15" width="20" height="2"></rect>
              </svg>
            </button>
            <a class="mobile-logo" href="/">
              <Image src={logo} alt="" width={424} height={414} />
            </a>
          </nav>
        </div>

        {/* Mobile off-canvas drawer (vanilla JS, replaces UIkit offcanvas) */}
        <div class="drawer" id="mobile-drawer" hidden>
          <div class="drawer__overlay" data-drawer-close></div>
          <div class="drawer__bar">
            <button class="drawer__close" type="button" aria-label="Close menu" data-drawer-close>
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                aria-hidden="true"
                stroke="currentColor"
                stroke-width="1.1"
              >
                <line x1="1" y1="1" x2="13" y2="13"></line>
                <line x1="13" y1="1" x2="1" y2="13"></line>
              </svg>
            </button>
            <ul class="drawer__nav">
              {
                [...navLeft, ...navRight].map((item) => (
                  <li class={active === item.key ? 'active' : ''}>
                    <a href={item.href} set:html={item.label} />
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {/* Desktop header */}
        <header class="tm-header site-header">
          <div class="uk-container">
            <div class="site-header__inner">
              <nav class="nav-group nav-group--left" aria-label="Primary">
                <ul>
                  {
                    navLeft.map((item) => (
                      <li class={active === item.key ? 'active' : ''}>
                        <a href={item.href} set:html={item.label} />
                      </li>
                    ))
                  }
                </ul>
              </nav>

              <a href="/" class="site-logo">
                <Image src={logo} alt="" width={424} height={414} />
              </a>

              <nav class="nav-group nav-group--right" aria-label="Primary">
                <ul>
                  {
                    navRight.map((item) => (
                      <li class={active === item.key ? 'active' : ''}>
                        <a href={item.href} set:html={item.label} />
                      </li>
                    ))
                  }
                </ul>
              </nav>
            </div>
          </div>
        </header>

        <slot />

        {/* Footer */}
        <div id="footer-1" class="uk-section-default uk-section">
          <div class="uk-container">
            <div class="uk-grid-margin" uk-grid>
              <div class="uk-width-1-1@m">
                <div class="footer" id="footer-4">
                  <p>
                    © Littleton Junior Football Club | <a href="/privacy-policy">Privacy</a> |
                    <a href="/terms-conditions">Terms</a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Page-level overrides moved to public/templates/yootheme/css/overrides.css
        and loaded via <link> above. Astro's <style is:global> in dev mode
        loads styles via Vite HMR which had timing/cache quirks. */}

    <script is:inline>
      // Mobile off-canvas drawer — tiny vanilla replacement for UIkit's
      // offcanvas. Slide-in via the .is-open class + a CSS transform.
      (function () {
        var drawer = document.getElementById('mobile-drawer');
        if (!drawer) return;
        var bar = drawer.querySelector('.drawer__bar');
        var toggles = document.querySelectorAll('[data-drawer-open]');
        function open() {
          drawer.hidden = false;
          drawer.getBoundingClientRect(); // force reflow so the transition runs
          drawer.classList.add('is-open');
          toggles.forEach(function (t) { t.setAttribute('aria-expanded', 'true'); });
          document.documentElement.style.overflow = 'hidden';
        }
        function close() {
          if (!drawer.classList.contains('is-open')) return;
          drawer.classList.remove('is-open');
          toggles.forEach(function (t) { t.setAttribute('aria-expanded', 'false'); });
          document.documentElement.style.overflow = '';
          var onEnd = function (e) {
            if (e.target !== bar) return;
            bar.removeEventListener('transitionend', onEnd);
            drawer.hidden = true;
          };
          bar.addEventListener('transitionend', onEnd);
        }
        toggles.forEach(function (t) { t.addEventListener('click', open); });
        document.querySelectorAll('[data-drawer-close]').forEach(function (b) {
          b.addEventListener('click', close);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });
      })();
    </script>
    <script is:inline>
      // Counter animation lifted from the live site's inline JS.
      // Runs once on DOMContentLoaded. Looks for .counter[data-count].
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.counter').forEach(function (el) {
          var target = parseInt(el.getAttribute('data-count'), 10) || 0;
          var start = 0;
          var duration = 2000;
          var startTime = null;
          function step(ts) {
            if (!startTime) startTime = ts;
            var progress = Math.min((ts - startTime) / duration, 1);
            // ease-out
            var eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.floor(start + (target - start) * eased).toString();
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = target.toString();
          }
          requestAnimationFrame(step);
        });
      });
    </script>
    <script is:inline>
      // On-scroll fade-in for the home squares (vanilla replacement for
      // UIkit uk-scrollspy). Reveals each [uk-scrollspy-class] card as it
      // enters the viewport by adding .uk-scrollspy-inview (CSS does the
      // fade). Gated by the .scrollspy-enabled class set in <head>.
      (function () {
        if (!document.documentElement.classList.contains('scrollspy-enabled')) return;
        var targets = document.querySelectorAll('[uk-scrollspy-class]');
        if (!targets.length || !('IntersectionObserver' in window)) return;
        // No rootMargin: fire as soon as a card's top edge enters the
        // viewport from the bottom (matching the old UIkit scrollspy), so a
        // card peeking at the bottom is already fading rather than sitting
        // blank until the next scroll.
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('uk-scrollspy-inview');
            io.unobserve(entry.target);
          });
        });
        targets.forEach(function (t) { io.observe(t); });
      })();
    </script>
  </body>
</html>
