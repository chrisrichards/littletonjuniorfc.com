---
/*
 * Booking form — behind Cloudflare Access.
 *
 * Access is configured to protect /schedule/book*, so an unauthenticated
 * visitor never reaches this code. The role check below is the second gate: it
 * decides what a signed-in person may do, which Access cannot express.
 */
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import { listRange, byId, pitches, type Booking } from '../../lib/bookings';
import { getUser } from '../../lib/access';
import { squads, squadsForEmail, adminExample } from '../../lib/squads';
import { today, addDays, formatLong } from '../../lib/dates';
import settings from '../../content/settings/bookings.json';

const user = await getUser(Astro.request);

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');

/*
 * ?edit=<id> turns the form into an edit of that booking. Loaded and permission
 * -checked here so the form can be pre-filled; the endpoint checks again on
 * submit, since a URL is not authorisation.
 */
const editId = Number(Astro.url.searchParams.get('edit'));
let editing: Booking | null = null;
if (user && user.role !== 'none' && Number.isInteger(editId) && editId > 0) {
  const b = await byId(env.DB, editId);
  const mayManage =
    b && !b.cancelled_at &&
    (user.role === 'admin' || (b.manager_email !== null && b.manager_email === user.email));
  editing = mayManage ? b : null;
}

const durationOf = (b: Booking) => {
  const mins = (t: string) => Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5));
  return mins(b.end_time) - mins(b.start_time);
};

const now = today();
const maxDate = addDays(now, settings.maxWeeksAhead * 7);

// Admins may book for any squad; a manager only for the squads they run.
const mine = user ? (user.role === 'admin' ? squads : squadsForEmail(user.email)) : [];

// Their upcoming bookings, for the cancel list.
const upcoming =
  user && user.role !== 'none'
    ? (await listRange(env.DB, now, maxDate)).filter(
        (b) => user.role === 'admin' || b.manager_email === user.email
      )
    : [];

const times: string[] = [];
for (let m = 0; m < 24 * 60; m += settings.slotMinutes) {
  const t = `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
  if (t >= settings.openingTime && t < settings.closingTime) times.push(t);
}
---

<BaseLayout title="Book a Pitch | Littleton Junior FC" description="Book a Littleton Rec pitch.">
  <Hero variant="image" image="/images/heros/teams.jpg" title="Book a<br>Pitch" />

  <Section width="full">
    <div class="sched-page">
      {ok && <p class="sched-msg is-ok">{ok}</p>}
      {err && <p class="sched-msg is-err">{err}</p>}

      {
        !user ? (
          import.meta.env.DEV ? (
            <>
              <h5>Not signed in</h5>
              <p>
                On the live site Cloudflare Access handles this: it asks for your email address,
                emails you a one-time code, and only then lets you through to this page. Access
                does not run in front of a local dev server, so pick an identity instead:
              </p>
              <ul class="sched-devsignin">
                <li>
                  <a href={`/schedule/book?as=${squads[0].managerEmail}`}>
                    {squads[0].managerEmail}
                  </a>{' '}
                  — team manager ({squads[0].label})
                </li>
                <li>
                  <a href={`/schedule/book?as=${adminExample()}`}>{adminExample()}</a> — committee,
                  can book for any team
                </li>
                <li>
                  <a href="/schedule/book?as=nobody@example.com">nobody@example.com</a> — not on the
                  allowlist, to check it is refused
                </li>
              </ul>
              <p>
                Add <code>?as=</code> to any URL to switch, or{' '}
                <a href="/schedule/book?as=">sign out</a>. This only exists in dev — it is compiled
                out of the deployed site.
              </p>
            </>
          ) : (
            <>
              <h5>Not signed in</h5>
              <p>
                Booking is only open to team managers, and sign-in is handled by Cloudflare Access
                before you reach this page — so seeing this message usually means the sign-in did
                not complete. Try <a href="/schedule/book">loading the page again</a>; if it keeps
                happening, contact your Age Group Coordinator on the{' '}
                <a href="/contact-us">Contact us</a> page.
              </p>
            </>
          )
        ) : user.role === 'none' ? (
          <p>
            <strong>{user.email}</strong> is not on the list of team managers. If you should be,
            ask your Age Group Coordinator on the <a href="/contact-us">Contact us</a> page.
          </p>
        ) : (
          <>
            <h5>{editing ? `Edit booking — ${editing.team_label}` : 'New booking'}</h5>
            <form class="sched-form" method="POST" action="/api/bookings">
              {editing && <input type="hidden" name="action" value="update" />}
              {editing && <input type="hidden" name="id" value={editing.id} />}

              <label>
                Team
                <select name="squad_id" required>
                  {mine.map((s) => (
                    <option value={s.id} selected={editing?.squad_id === s.id}>
                      {s.label}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                Pitch
                <select name="pitch" required>
                  {pitches.map((p) => (
                    <option value={p.id} selected={editing?.pitch === p.id}>
                      {p.label}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                Date
                <input
                  type="date"
                  name="date"
                  required
                  min={now}
                  max={maxDate}
                  value={editing?.date ?? now}
                />
              </label>

              <label>
                Start
                <select name="start_time" required>
                  {times.map((t) => (
                    <option value={t} selected={t === (editing?.start_time ?? '09:30')}>
                      {t}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                Duration
                <select name="duration" required>
                  {settings.durations.map((d) => (
                    <option value={d} selected={d === (editing ? durationOf(editing) : 120)}>
                      {d % 60 === 0 ? `${d / 60} hours` : `${Math.floor(d / 60)}h ${d % 60}m`}
                    </option>
                  ))}
                </select>
              </label>

              <div class="sched-form-actions">
                <button class="uk-button uk-button-default" type="submit">
                  {editing ? 'Save changes' : 'Book pitch'}
                </button>
                {editing && <a href="/schedule/book">Cancel edit</a>}
              </div>
            </form>

            <h5 class="sched-upcoming-title">
              {user.role === 'admin' ? 'All upcoming bookings' : 'Your upcoming bookings'}
            </h5>
            {upcoming.length === 0 ? (
              <p>No upcoming bookings.</p>
            ) : (
              <ul class="sched-list">
                {upcoming.map((b) => (
                  <li>
                    <span>
                      <strong>{b.team_label}</strong> — {pitches.find((p) => p.id === b.pitch)?.label}
                      , {formatLong(b.date)}, {b.start_time}–{b.end_time}
                    </span>
                    <span class="sched-rowactions">
                      <a
                        class="uk-button uk-button-default sched-edit"
                        href={`/schedule/book?edit=${b.id}`}
                      >
                        Edit
                      </a>
                      <form method="POST" action="/api/bookings">
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={b.id} />
                        <button class="uk-button uk-button-default sched-cancel" type="submit">
                          Delete
                        </button>
                      </form>
                    </span>
                  </li>
                ))}
              </ul>
            )}

            <p class="sched-foot">
              Signed in as {user.email}
              {user.role === 'admin' ? ' (committee)' : ''}. <a href="/schedule#schedule">Back to the schedule</a>
              .
            </p>
          </>
        )
      }
    </div>
  </Section>
</BaseLayout>
