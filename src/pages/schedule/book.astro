---
/*
 * Booking form — behind Cloudflare Access.
 *
 * Access is configured to protect /schedule/book*, so an unauthenticated
 * visitor never reaches this code. The role check below is the second gate: it
 * decides what a signed-in person may do, which Access cannot express.
 */
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import { listRange, pitches } from '../../lib/bookings';
import { getUser } from '../../lib/access';
import { squads, squadsForEmail } from '../../lib/squads';
import { today, addDays, formatLong } from '../../lib/dates';
import settings from '../../content/settings/bookings.json';

const user = await getUser(Astro.request);

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');

const now = today();
const maxDate = addDays(now, settings.maxWeeksAhead * 7);

// Admins may book for any squad; a manager only for the squads they run.
const mine = user ? (user.role === 'admin' ? squads : squadsForEmail(user.email)) : [];

// Their upcoming bookings, for the cancel list.
const upcoming =
  user && user.role !== 'none'
    ? (await listRange(env.DB, now, maxDate)).filter(
        (b) => user.role === 'admin' || b.manager_email === user.email
      )
    : [];

const times: string[] = [];
for (let m = 0; m < 24 * 60; m += settings.slotMinutes) {
  const t = `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
  if (t >= settings.openingTime && t < settings.closingTime) times.push(t);
}
---

<BaseLayout title="Book a Pitch | Littleton Junior FC" description="Book a Littleton Rec pitch.">
  <Hero variant="image" image="/images/heros/teams.jpg" title="Book a<br>Pitch" />

  <Section width="full">
    {ok && <p class="sched-msg is-ok">{ok}</p>}
    {err && <p class="sched-msg is-err">{err}</p>}

    {
      !user ? (
        <p>
          You are not signed in. <a href="/schedule">Back to the schedule</a>.
        </p>
      ) : user.role === 'none' ? (
        <p>
          <strong>{user.email}</strong> is not on the list of team managers. If you should be,
          ask your Age Group Coordinator on the <a href="/contact-us">Contact us</a> page.
        </p>
      ) : (
        <>
          <h5>New booking</h5>
          <form class="sched-form" method="POST" action="/api/bookings">
            <label>
              Team
              <select name="squad_id" required>
                {mine.map((s) => (
                  <option value={s.id}>{s.label}</option>
                ))}
              </select>
            </label>

            <label>
              Pitch
              <select name="pitch" required>
                {pitches.map((p) => (
                  <option value={p.id}>{p.label}</option>
                ))}
              </select>
            </label>

            <label>
              Date
              <input type="date" name="date" required min={now} max={maxDate} value={now} />
            </label>

            <label>
              Start
              <select name="start_time" required>
                {times.map((t) => (
                  <option value={t} selected={t === '09:30'}>
                    {t}
                  </option>
                ))}
              </select>
            </label>

            <label>
              Duration
              <select name="duration" required>
                {settings.durations.map((d) => (
                  <option value={d} selected={d === 120}>
                    {d % 60 === 0 ? `${d / 60} hours` : `${Math.floor(d / 60)}h ${d % 60}m`}
                  </option>
                ))}
              </select>
            </label>

            <button class="uk-button uk-button-default" type="submit">
              Book pitch
            </button>
          </form>

          <h5 class="sched-upcoming-title">
            {user.role === 'admin' ? 'All upcoming bookings' : 'Your upcoming bookings'}
          </h5>
          {upcoming.length === 0 ? (
            <p>No upcoming bookings.</p>
          ) : (
            <ul class="sched-list">
              {upcoming.map((b) => (
                <li>
                  <span>
                    <strong>{b.team_label}</strong> — {pitches.find((p) => p.id === b.pitch)?.label}
                    , {formatLong(b.date)}, {b.start_time}–{b.end_time}
                  </span>
                  <form method="POST" action="/api/bookings">
                    <input type="hidden" name="action" value="cancel" />
                    <input type="hidden" name="id" value={b.id} />
                    <button class="uk-button uk-button-default sched-cancel" type="submit">
                      Cancel
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}

          <p class="sched-foot">
            Signed in as {user.email}
            {user.role === 'admin' ? ' (committee)' : ''}. <a href="/schedule">Back to the schedule</a>
            .
          </p>
        </>
      )
    }
  </Section>
</BaseLayout>
